# Clé d'accès TMDB (API Read Access Token, v4 auth)
# Récupère la tienne sur https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_ACCESS_TOKEN=

# Config de l'app web Firebase (Project settings > vos applications > icône </>)
# Ces valeurs ne sont pas secrètes : la protection se fait via les règles de
# sécurité Firestore (firestore.rules), pas via la confidentialité de ces clés.
# Sert uniquement à la fonctionnalité "Partager ma liste" (synchro entre
# téléphones) ; sans elles, l'app fonctionne normalement en local.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
