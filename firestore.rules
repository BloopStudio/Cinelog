rules_version = '2';

// À coller dans la Console Firebase : Firestore Database > Rules.
// Modèle : une liste partagée (accessible via un code = l'id du document
// dans "lists") a une sous-collection "members" (qui a le droit de la
// lire/modifier) et une sous-collection "items" (les films/séries).
// Connaître le code == avoir l'équivalent d'une invitation : n'importe quel
// utilisateur authentifié (anonyme) peut créer sa propre entrée "members"
// pour un id de liste qu'il connaît déjà, ce qui lui donne ensuite accès à
// "items". Personne ne peut lister les codes existants ni deviner un accès
// sans connaître le code lui-même (haute entropie, 8 caractères).
service cloud.firestore {
  match /databases/{database}/documents {
    match /lists/{listId} {
      allow get: if request.auth != null;
      allow create: if request.auth != null;

      match /members/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }

      match /items/{itemId} {
        allow read, write: if request.auth != null &&
          exists(/databases/$(database)/documents/lists/$(listId)/members/$(request.auth.uid));
      }
    }
  }
}
